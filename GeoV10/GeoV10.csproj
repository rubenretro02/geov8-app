<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms NotifyIcon: tray icon + balloon notifications (background mode) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Keep the exe name the Python updater and its cleanup routines look for -->
    <AssemblyName>app</AssemblyName>
    <RootNamespace>GeoV10</RootNamespace>
    <ApplicationIcon>geo.ico</ApplicationIcon>
    <Version>10.0.2.3</Version>
    <FileVersion>10.0.2.3</FileVersion>
    <AssemblyVersion>10.0.2.3</AssemblyVersion>
    <Product>Geo</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Single self-contained exe: nothing to install on the VMs -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression keeps the bundle at ~64 MB (147 MB without). Defender's local
         engine passes either way; the download block seen in the field is
         reputation-based (unsigned, new file) and needs code signing, not this. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <DebugType>none</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- UseWindowsForms adds these as global usings, which collide with WPF
       (Application, Point, Brush, Button...). Drop the globals; TrayIcon.cs
       imports System.Windows.Forms / System.Drawing explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
