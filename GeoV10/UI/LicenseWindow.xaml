<Window x:Class="GeoV10.UI.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License" Width="400" Height="320" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgDark}" Foreground="{StaticResource Text}">
    <StackPanel Margin="30,20">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border x:Name="ExistingPanel" Style="{StaticResource Card}" CornerRadius="8" Padding="10,5,10,8" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Your license:" Style="{StaticResource Secondary}" FontSize="10"/>
                <TextBlock x:Name="ExistingText" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TextBox x:Name="KeyBox" Height="45" FontSize="16" TextAlignment="Center" CharacterCasing="Upper"
                 Margin="0,0,0,10" KeyDown="KeyBox_KeyDown"/>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource Error}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <Button x:Name="ActivateBtn" Content="Activate" Style="{StaticResource PrimaryButton}" Width="150" Height="40"
                HorizontalAlignment="Center" Click="Activate_Click"/>
    </StackPanel>
</Window>
