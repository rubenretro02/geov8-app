<Window x:Class="GeoV10.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GeoV10.UI"
        Title="" Width="700" Height="650" MinWidth="650" MinHeight="600"
        Background="{StaticResource BgDark}" Foreground="{StaticResource Text}" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: navigation only, right side -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DashboardBtn" Content="⌂" Style="{StaticResource NavButton}" FontSize="18" FontWeight="Bold" Click="ShowDashboard"/>
            <Button x:Name="DetailsBtn" Content="◉" Style="{StaticResource NavButton}" Click="ShowDetails"/>
            <Button x:Name="SettingsBtn" Content="⚙" Style="{StaticResource NavButton}" Click="ShowSettings"/>
            <TextBlock x:Name="VersionLabel" Style="{StaticResource Secondary}" FontSize="9" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Dashboard -->
        <Border x:Name="DashboardPanel" Grid.Row="1" Margin="0,20,0,15" Background="{StaticResource BgCard}" CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45*"/>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="15*"/>
                </Grid.RowDefinitions>
                <ui:AnimatedCircle x:Name="Circle" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                <Button x:Name="RunBtn" Grid.Row="1" Content="▶  Start" Style="{StaticResource PrimaryButton}" Width="140" Height="45"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Click="Run_Click"/>
                <TextBlock x:Name="StatusMessage" Grid.Row="2" Text="" HorizontalAlignment="Center" VerticalAlignment="Top"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="24,0,24,0" FontSize="12"/>
                <StackPanel x:Name="AutoClosePanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="AutoCloseLabel" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="✕ Cancel" Style="{StaticResource FlatButton}" Tag="12" Width="70" Height="24" FontSize="11" Click="CancelAutoClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Details -->
        <ScrollViewer x:Name="DetailsPanel" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="IpText" Text="---.---.---.---" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,2"/>
                        <TextBlock Text="Public IP" Style="{StaticResource Secondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <Rectangle Height="1" Fill="{StaticResource Border}" Margin="15,5"/>
                        <Grid Margin="15,5,15,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Country:" Style="{StaticResource Secondary}" Grid.Row="0"/><TextBlock x:Name="IpCountry" Text="--" FontSize="11" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Text="Location:" Style="{StaticResource Secondary}" Grid.Row="1"/><TextBlock x:Name="IpLocation" Text="--" FontSize="11" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Text="ISP:" Style="{StaticResource Secondary}" Grid.Row="2"/><TextBlock x:Name="IpIsp" Text="--" FontSize="11" Grid.Row="2" Grid.Column="1"/>
                            <TextBlock Text="Hostname:" Style="{StaticResource Secondary}" Grid.Row="3"/><TextBlock x:Name="IpHostname" Text="--" FontSize="11" Grid.Row="3" Grid.Column="1"/>
                            <TextBlock Text="Type:" Style="{StaticResource Secondary}" Grid.Row="4"/><TextBlock x:Name="IpType" Text="--" FontSize="11" Grid.Row="4" Grid.Column="1"/>
                            <TextBlock Text="Version:" Style="{StaticResource Secondary}" Grid.Row="5"/><TextBlock x:Name="IpVersion" Text="--" FontSize="11" Grid.Row="5" Grid.Column="1"/>
                            <TextBlock Text="Status:" Style="{StaticResource Secondary}" Grid.Row="6"/><TextBlock x:Name="IpStatus" Text="--" FontSize="11" Grid.Row="6" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📍 GPS Coordinates" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="15,12,15,8"/>
                        <Rectangle Height="1" Fill="{StaticResource Border}" Margin="15,0"/>
                        <Grid Margin="15,8,15,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Coords:" Style="{StaticResource Secondary}" Grid.Row="0"/><TextBlock x:Name="GpsCoords" Text="--" FontSize="11" Grid.Row="0" Grid.Column="1"/>
                            <TextBlock Text="Location:" Style="{StaticResource Secondary}" Grid.Row="1"/><TextBlock x:Name="GpsLocation" Text="--" FontSize="11" Grid.Row="1" Grid.Column="1"/>
                            <TextBlock Text="Status:" Style="{StaticResource Secondary}" Grid.Row="2"/><TextBlock x:Name="GpsStatus" Text="--" FontSize="11" Grid.Row="2" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Margin="0,20,0,0" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="App Info" Style="{StaticResource SectionTitle}" Margin="16,12,16,5"/>
                        <TextBlock x:Name="AgentText" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="16,0"/>
                        <TextBlock x:Name="LicenseStatusText" FontSize="11" Margin="16,0"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" FontSize="10" Margin="16,0"/>
                        <TextBlock x:Name="LicenseKeyText" Style="{StaticResource Secondary}" FontSize="10" Margin="16,0"/>
                        <TextBlock x:Name="HwidText" Style="{StaticResource Secondary}" FontSize="10" Margin="16,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="16,12,16,8">
                            <TextBlock Text="Auto-Check" FontSize="14" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="AutoLabel" Text="OFF" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox x:Name="AutoSwitch" Margin="0" VerticalAlignment="Center" Click="AutoSwitch_Click"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="16,0,16,8">
                            <TextBlock Text="Interval:" Style="{StaticResource Secondary}" Width="60" VerticalAlignment="Center"/>
                            <TextBox x:Name="IntervalBox" Width="50" Text="5"/>
                            <TextBlock Text="min" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowOnAutoCheck" Content="Show on auto check"/>
                        <TextBlock x:Name="CountdownLabel" Style="{StaticResource Secondary}" FontSize="10" Margin="16,0,16,12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Device Portal" Style="{StaticResource SectionTitle}"/>
                        <Grid Style="{StaticResource Field}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Username" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                            <TextBox x:Name="UsernameBox" Grid.Column="1"/>
                        </Grid>
                        <Grid Style="{StaticResource Field}" Margin="16,2,16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Password" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="PasswordInput" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GPS Coordinates" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="16,0,16,8">
                            <RadioButton x:Name="GpsAutoRadio" Content="Use IP coords" GroupName="gps" Margin="0,0,15,0" Checked="GpsMode_Changed"/>
                            <RadioButton x:Name="GpsCustomRadio" Content="Custom" GroupName="gps" IsChecked="True" Checked="GpsMode_Changed"/>
                        </StackPanel>
                        <!-- Only shown in Custom mode; hidden entirely for "Use IP coords" -->
                        <StackPanel x:Name="CoordFields">
                            <Grid Style="{StaticResource Field}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Latitude" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="LatBox" Grid.Column="1"/>
                            </Grid>
                            <Grid Style="{StaticResource Field}" Margin="16,2,16,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBlock Text="Longitude" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="LonBox" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Allowed Countries" Style="{StaticResource SectionTitle}" Margin="16,12,16,4"/>
                        <TextBlock x:Name="LocationLockHint" Text="🔒 Set by your manager - contact them to change it"
                                   Foreground="{StaticResource Warning}" FontSize="10" Margin="16,0,16,4" Visibility="Collapsed"/>
                        <TextBox x:Name="CountriesBox" Height="40" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Background="{StaticResource BgDark}" Margin="16,0,16,12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Allowed States" Style="{StaticResource SectionTitle}" Margin="16,12,16,4"/>
                        <TextBox x:Name="StatesBox" Height="40" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Background="{StaticResource BgDark}" Margin="16,0,16,12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="16,12,16,4">
                            <TextBlock Text="Telegram Notifications" FontSize="14" FontWeight="Bold"/>
                            <CheckBox x:Name="TelegramEnabled" Content="On" HorizontalAlignment="Right" Margin="0"/>
                        </Grid>
                        <Button Content="+ Connect Telegram" Style="{StaticResource FlatButton}" Tag="8" Height="34"
                                Margin="16,4,16,8" Background="{StaticResource AccentEnd}" Foreground="White" BorderThickness="0"
                                Click="ConnectTelegram_Click"/>
                        <TextBlock Text="Chat IDs (comma-separated)" Style="{StaticResource Secondary}" Margin="16,0"/>
                        <TextBox x:Name="TelegramChatIds" Margin="16,2,16,10"/>

                        <TextBlock Text="WHEN TO NOTIFY:" Foreground="{StaticResource Warning}" FontSize="10" FontWeight="Bold" Margin="16,0,16,4"/>
                        <StackPanel Orientation="Horizontal" Margin="16,0,16,8">
                            <CheckBox x:Name="AlertOnSuccess" Content="On success" Margin="0,0,20,0"/>
                            <CheckBox x:Name="AlertOnFail" Content="On failure" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="ALERT FOR THESE ISSUES:" Foreground="{StaticResource Warning}" FontSize="10" FontWeight="Bold" Margin="16,0,16,4"/>
                        <StackPanel Orientation="Horizontal" Margin="16,0,16,12">
                            <CheckBox x:Name="AlertIp" Content="IP location" Margin="0,0,20,0"/>
                            <CheckBox x:Name="AlertGps" Content="GPS coords" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="💾  Save Settings" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,4,0,20" Click="Save_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
